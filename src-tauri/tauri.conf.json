{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyra Explorer Preview",
  "version": "0.2.1",
  "identifier": "com.veyra.explorerpreview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veyra Explorer Preview",
        "width": 1360,
        "height": 880,
        "minWidth": 680,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

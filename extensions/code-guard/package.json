{
  "name": "veyra-code-guard",
  "displayName": "Veyra Code Guard",
  "description": "A security reviewer for code in any language. Checks every line for trojans, backdoors, web shells, ransomware, spyware and supply-chain attacks, rescans as soon as malicious code is removed, explains how to fix each finding, grades your project A to F and creates a PDF security report. In VS Code, before every commit and on every GitHub pull request.",
  "version": "1.2.0",
  "publisher": "flightcoders",
  "author": {
    "name": "Flight Coders"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "pricing": "Free",
  "homepage": "https://veyraeditor.com/code-guard",
  "repository": {
    "type": "git",
    "url": "https://github.com/fcopensource/veyraeditor.git",
    "directory": "extensions/code-guard"
  },
  "bugs": {
    "url": "https://github.com/fcopensource/veyraeditor/issues"
  },
  "qna": "https://github.com/fcopensource/veyraeditor/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "malware",
    "trojan",
    "trojan source",
    "backdoor",
    "web shell",
    "ransomware",
    "keylogger",
    "shellcode",
    "supply chain",
    "typosquatting",
    "code review",
    "security report",
    "pdf",
    "sarif",
    "pre-commit",
    "secrets",
    "veyra"
  ],
  "galleryBanner": {
    "color": "#0b1214",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./bundle/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "veyraGuard.scanWorkspace",
        "title": "Scan Whole Workspace",
        "category": "Veyra Code Guard",
        "icon": "$(search)"
      },
      {
        "command": "veyraGuard.createReport",
        "title": "Create Security Report (PDF)",
        "category": "Veyra Code Guard",
        "icon": "$(file-pdf)"
      },
      {
        "command": "veyraGuard.installHook",
        "title": "Install Pre-commit Guard",
        "category": "Veyra Code Guard",
        "icon": "$(git-commit)"
      },
      {
        "command": "veyraGuard.removeHook",
        "title": "Remove Pre-commit Guard",
        "category": "Veyra Code Guard"
      },
      {
        "command": "veyraGuard.scanFile",
        "title": "Scan This File",
        "category": "Veyra Code Guard"
      },
      {
        "command": "veyraGuard.removeHiddenCharacters",
        "title": "Remove Hidden Characters from This File",
        "category": "Veyra Code Guard",
        "icon": "$(eye-closed)"
      },
      {
        "command": "veyraGuard.createConfig",
        "title": "Create Team Settings File (.veyra-guard.json)",
        "category": "Veyra Code Guard",
        "icon": "$(settings-gear)"
      },
      {
        "command": "veyraGuard.rescan",
        "title": "Rescan File",
        "category": "Veyra Code Guard"
      },
      {
        "command": "veyraGuard.listRules",
        "title": "What It Looks For",
        "category": "Veyra Code Guard",
        "icon": "$(book)"
      },
      {
        "command": "veyraGuard.clear",
        "title": "Clear Results",
        "category": "Veyra Code Guard",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "veyraGuard.scanFile",
          "when": "editorIsOpen"
        },
        {
          "command": "veyraGuard.removeHiddenCharacters",
          "when": "editorIsOpen"
        },
        {
          "command": "veyraGuard.rescan",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "veyraGuard.scanWorkspace",
          "group": "7_modification@9"
        }
      ],
      "view/title": [
        {
          "command": "veyraGuard.scanWorkspace",
          "when": "view == veyraGuard.findings",
          "group": "navigation@1"
        },
        {
          "command": "veyraGuard.createReport",
          "when": "view == veyraGuard.findings",
          "group": "navigation@2"
        },
        {
          "command": "veyraGuard.installHook",
          "when": "view == veyraGuard.findings",
          "group": "navigation@3"
        },
        {
          "command": "veyraGuard.listRules",
          "when": "view == veyraGuard.findings",
          "group": "more@1"
        },
        {
          "command": "veyraGuard.createConfig",
          "when": "view == veyraGuard.findings",
          "group": "more@2"
        },
        {
          "command": "veyraGuard.clear",
          "when": "view == veyraGuard.findings",
          "group": "more@3"
        }
      ]
    },
    "configuration": {
      "title": "Veyra Code Guard",
      "properties": {
        "veyraGuard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check files as you open, edit and save them."
        },
        "veyraGuard.scanWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "Check a file again shortly after you stop typing."
        },
        "veyraGuard.minSeverity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "enumDescriptions": [
            "Everything, including install hooks worth a look",
            "Medium and above",
            "High and critical only",
            "Only the most dangerous findings"
          ],
          "default": "low",
          "description": "The lowest severity to show."
        },
        "veyraGuard.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Rule ids to turn off, such as `raw-ip-url` or `base64-blob`. Run **Veyra Code Guard: What It Looks For** to see them all."
        },
        "veyraGuard.watchFiles": {
          "type": "boolean",
          "default": true,
          "description": "Check files that change on disk outside the editor (git pull, a package install, another program), and clear findings for files that are deleted."
        },
        "veyraGuard.ignorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Paths to skip, such as `docs/**` or `*.min.js`. Teams can also list them in `.veyra-guard.json`."
        },
        "veyraGuard.customRules": {
          "type": "array",
          "default": [],
          "markdownDescription": "Your own patterns, checked on every line in any language. Each needs an `id` and a `pattern` (a regular expression); `severity`, `title`, `message`, `why`, `fix` and `files` (globs) are optional. To share them with your team, the command line and the GitHub Action, put them in `.veyra-guard.json` instead.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pattern"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              },
              "flags": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "title": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "fix": {
                "type": "string"
              },
              "files": {
                "type": [
                  "string",
                  "array"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veyra-code-guard",
          "title": "Code Guard",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "veyra-code-guard": [
        {
          "id": "veyraGuard.findings",
          "name": "Findings",
          "icon": "media/activity.svg",
          "contextualTitle": "Veyra Code Guard"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "veyraGuard.findings",
        "contents": "No suspicious code in the files checked so far.\n[$(search) Scan Whole Workspace](command:veyraGuard.scanWorkspace)\n[$(file-pdf) Create Security Report (PDF)](command:veyraGuard.createReport)\nStop risky code before it's committed:\n[$(git-commit) Install Pre-commit Guard](command:veyraGuard.installHook)\nShare settings and your own rules with your team:\n[$(settings-gear) Create Team Settings File](command:veyraGuard.createConfig)\n[What it looks for](command:veyraGuard.listRules)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".veyra-guard.json",
        "url": "./media/veyra-guard.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=bundle/extension.js --log-level=warning --banner:js=\"// veyra-guard-ignore-file: built from src/, which defines the detection rules.\" && esbuild src/action.ts --bundle --platform=node --format=cjs --target=node18 --outfile=bundle/cli.js --log-level=warning --banner:js=\"// veyra-guard-ignore-file: built from src/, which defines the detection rules.\" && esbuild src/action.ts --bundle --platform=node --format=cjs --target=node20 --outfile=action/index.js --log-level=warning --banner:js=\"// veyra-guard-ignore-file: built from src/, which defines the detection rules.\"",
    "test": "tsc -p . && npm run bundle && node --test test/scanner.test.mjs test/report.test.mjs test/action.test.mjs",
    "test:integration": "tsc -p . && npm run bundle && node test/integration/run.mjs",
    "package": "npm run bundle && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies --out dist/",
    "vscode:prepublish": "tsc -p . && npm run bundle"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}

# Public site address used in emails and page metadata.
SITE_URL=https://veyraeditor.com
NEXT_PUBLIC_SITE_URL=https://veyraeditor.com

# MySQL (Hostinger: hPanel -> Databases -> MySQL Databases). Use either DATABASE_URL...
# DATABASE_URL=mysql://u123_veyra:password@localhost:3306/u123_veyra
# ...or the individual settings:
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_veyra
DB_PASSWORD=change-me
DB_NAME=u123456789_veyra

# Email for password resets (Hostinger: hPanel -> Emails; create e.g. no-reply@veyraeditor.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@veyraeditor.com
SMTP_PASSWORD=change-me
MAIL_FROM="Veyra <no-reply@veyraeditor.com>"

# Search engines (optional): verification codes from Google Search Console / Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional GitHub release metadata timeout. The website falls back gracefully.
RELEASE_FETCH_TIMEOUT_MS=3500

# Veyra AI: the built-in "Veyra AI" model in the app. Users sign in with their Veyra account; your key stays here.
# Set ONE provider (if you set several, VEYRA_AI_PROVIDER chooses: openai | anthropic | compatible).
#   OpenAI
OPENAI_API_KEY=
# VEYRA_OPENAI_MODEL=gpt-4.1-mini
#   Claude (Anthropic)
# ANTHROPIC_API_KEY=
# VEYRA_CLAUDE_MODEL=claude-opus-5-5
# VEYRA_CLAUDE_EFFORT=medium
#   Any OpenAI-compatible provider (Gemini, Groq, OpenRouter, DeepSeek, Mistral, xAI, Together…)
# VEYRA_AI_API_KEY=
# VEYRA_AI_BASE_URL=https://api.groq.com/openai/v1
# VEYRA_AI_MODEL=llama-3.3-70b-versatile
# VEYRA_AI_PROVIDER=
VEYRA_AI_DAILY_LIMIT=100

{
  "manifest_version": 3,
  "name": "JSON Viewer Veyra",
  "short_name": "JSON Viewer",
  "version": "1.0.0",
  "description": "View JSON as a clear, searchable tree. Exact big numbers, the path of every value, errors with line numbers. Private and offline.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "JSON Viewer: paste or open JSON",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/core.js", "src/render.js", "src/content.js"],
      "css": ["src/viewer.css"],
      "run_at": "document_end"
    }
  ],
  "homepage_url": "https://veyraeditor.com/json-viewer"
}
